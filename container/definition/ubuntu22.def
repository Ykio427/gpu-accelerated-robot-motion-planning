
Bootstrap: debootstrap

OSVersion: jammy

MirrorURL: https://mirrors.tuna.tsinghua.edu.cn/ubuntu/

Include: ca-certificates, curl, gnupg, lsb-release, locales

%post
    sed -i 's/ main$/ main universe/' /etc/apt/sources.list  
   
    apt-get update

    apt-get install -y \
        build-essential \
        cmake \
        git \
        curl \
        wget \
        ca-certificates \
        gnupg \
        lsb-release \
        locales \
        python3 \
        python3-pip \
        python3-dev

    locale-gen en_US.UTF-8

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8

%runscript
    exec /bin/bash "$@"
